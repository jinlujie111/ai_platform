# Optional storage overrides
AI_PLATFORM_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/ai_platform.db
MAX_UPLOAD_BYTES=52428800

# Default app port
APP_PORT=8000

# The UI sends Embedding/Chroma credentials per request for this demo.
# API keys are intentionally not persisted in SQLite.
# Leave chroma_path empty in knowledge-base settings to use local ./data/chroma
