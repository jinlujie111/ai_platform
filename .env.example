AI_PLATFORM_DATA_DIR=./data
DATABASE_URL=mysql+pymysql://root:jinlujie@127.0.0.1:3306/ai_platform?charset=utf8mb4
MAX_UPLOAD_BYTES=52428800
APP_PORT=8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=系统管理员
ENABLE_SCHEDULER=true

# Auth / session signing (change in production)
AUTH_SECRET=change-me-in-production

# Encrypt datasource passwords & workspace API keys at rest
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRETS_MASTER_KEY=

# Embedding/model keys etc. stored per user in user_workspace_settings
# 是否开放公开注册（false 则仅管理员可建用户）
ALLOW_PUBLIC_REGISTER=true

# 种子管理员使用默认口令时会强制改密后才能调用业务 API

# ─── AI Gateway ───────────────────────────────────────────────────────────────
# 每用户每分钟请求数（管理员豁免）
GATEWAY_RPM=30
# 每 API Key 每分钟请求数
GATEWAY_API_KEY_RPM=60
# 每用户每日 Token 上限
GATEWAY_DAILY_TOKENS=500000
# 可选：种子厂商 Key（写入 model_providers，加密存储）
# GATEWAY_SEED_DEEPSEEK_KEY=
# GATEWAY_SEED_QWEN_KEY=
# GATEWAY_SEED_OPENAI_KEY=
# GATEWAY_SEED_ANTHROPIC_KEY=
# 飞书优先走 Gateway 逻辑模型/路由（无 FEISHU_LLM_* 时）
# FEISHU_GATEWAY_MODEL=default

# ─── Tushare MCP（内置 /mcp/tushare）──────────────────────────────────────────
# 在 https://tushare.pro 获取 token
TUSHARE_TOKEN=
# 访问 api.tushare.pro 时走 HTTP 代理（可选）
# TUSHARE_HTTP_PROXY=http://127.0.0.1:7890
# 也兼容通用环境变量：HTTP_PROXY / HTTPS_PROXY / ALL_PROXY
# TUSHARE_API_URL=http://api.tushare.pro
